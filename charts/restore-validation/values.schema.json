{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "sourceArchive",
    "sourceProfile",
    "sourceStatePolicy",
    "controller",
    "objectStore",
    "operational"
  ],
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z_][a-z0-9_-]{0,62}$"
    },
    "databaseInventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "allow_connections"],
      "properties": {
        "name": { "$ref": "#/definitions/identifier" },
        "owner": { "$ref": "#/definitions/identifier" },
        "allow_connections": { "const": true }
      }
    },
    "roleAttributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "superuser",
        "inherit",
        "createrole",
        "createdb",
        "canlogin",
        "replication",
        "bypassrls"
      ],
      "properties": {
        "superuser": { "type": "boolean" },
        "inherit": { "type": "boolean" },
        "createrole": { "type": "boolean" },
        "createdb": { "type": "boolean" },
        "canlogin": { "type": "boolean" },
        "replication": { "type": "boolean" },
        "bypassrls": { "type": "boolean" }
      }
    },
    "roleInventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "attributes", "memberships"],
      "properties": {
        "name": { "$ref": "#/definitions/identifier" },
        "attributes": { "$ref": "#/definitions/roleAttributes" },
        "memberships": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/identifier" }
        }
      }
    }
  },
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "backupChild", "postgresql"],
      "properties": {
        "orchestrator": { "type": "string", "pattern": "^[^ @]+@sha256:[0-9a-f]{64}$" },
        "backupChild": { "type": "string", "pattern": "^[^ @]+@sha256:[0-9a-f]{64}$" },
        "postgresql": { "type": "string", "pattern": "^[^ @]+@sha256:[0-9a-f]{64}$" }
      }
    },
    "sourceArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container", "prefix"],
      "properties": {
        "container": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "prefix": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "sourceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedSystemIdentifier",
        "postgresqlStorageSize",
        "sourcePvcSize",
        "requiredDatabaseInventory",
        "requiredStaticRoleInventory",
        "dynamicRolePrefixes",
        "expectedMigrationVersion",
        "minimumRowCounts",
        "syntheticRow"
      ],
      "properties": {
        "expectedSystemIdentifier": { "type": "string", "pattern": "^[1-9][0-9]{0,31}$" },
        "postgresqlStorageSize": {
          "type": "string",
          "pattern": "^([4-9][0-9]|[1-9][0-9]{2,})Gi$|^[1-9][0-9]*Ti$"
        },
        "sourcePvcSize": {
          "type": "string",
          "pattern": "^([4-9][0-9]|[1-9][0-9]{2,})Gi$|^[1-9][0-9]*Ti$"
        },
        "requiredDatabaseInventory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/databaseInventoryEntry" }
        },
        "requiredStaticRoleInventory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/roleInventoryEntry" }
        },
        "dynamicRolePrefixes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 63 }
        },
        "expectedMigrationVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "minimumRowCounts": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "$ref": "#/definitions/identifier" },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        },
        "syntheticRow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "email_sha256"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "email_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "sourceStatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missingCount", "orphanCount", "sha256"],
      "properties": {
        "missingCount": { "type": "integer", "minimum": 0, "maximum": 256 },
        "orphanCount": { "type": "integer", "minimum": 0, "maximum": 256 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseSeconds",
        "initializationGraceSeconds",
        "maxRuntimeSeconds",
        "stageTimeoutSeconds",
        "retainedSeconds",
        "casRetries",
        "maxRetainedRuns",
        "maxChildResources",
        "maxJobs",
        "maxPvcs"
      ],
      "properties": {
        "leaseSeconds": { "type": "integer", "minimum": 10, "maximum": 300 },
        "initializationGraceSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
        "maxRuntimeSeconds": { "type": "integer", "minimum": 60, "maximum": 21600 },
        "stageTimeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 7200 },
        "retainedSeconds": { "type": "integer", "minimum": 3600, "maximum": 172800 },
        "casRetries": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxRetainedRuns": { "type": "integer", "minimum": 0, "maximum": 2 },
        "maxChildResources": { "type": "integer", "minimum": 10, "maximum": 64 },
        "maxJobs": { "type": "integer", "minimum": 4, "maximum": 32 },
        "maxPvcs": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "objectStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "destinationPath"],
      "properties": {
        "enabled": { "type": "boolean" },
        "destinationPath": { "type": "string", "maxLength": 2048 }
      }
    },
    "operational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "weeklySuspend", "schedule", "egressProxy"],
      "properties": {
        "enabled": { "type": "boolean" },
        "weeklySuspend": { "type": "boolean" },
        "schedule": { "const": "0 11 * * 0" },
        "egressProxy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "allowedConnectHosts"],
          "properties": {
            "image": {
              "const": "envoyproxy/envoy:v1.39.1@sha256:57e14a549d7bd43c8d3f6d03e8cfa653e037d4b38e133acd9b54f38c524401b4"
            },
            "allowedConnectHosts": {
              "type": "array",
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]{3,24}\\.blob\\.core\\.windows\\.net:443$"
              }
            }
          }
        }
      }
    }
  }
}
