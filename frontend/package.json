{
  "name": "frontend",
  "private": true,
  "version": "0.61.1",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write .. --ignore-path ../.prettierignore",
    "format:check": "prettier --check .. --ignore-path ../.prettierignore",
    "format:staged": "node scripts/format-staged.mjs",
    "lint": "eslint .",
    "licenses:generate": "node scripts/generate-third-party-licenses.mjs",
    "licenses:check": "node scripts/generate-third-party-licenses.mjs --check",
    "prepare": "node scripts/install-git-hooks.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --build-script-name build-storybook",
    "test": "vitest run --config vite.config.ts",
    "test:storybook": "vitest --config vitest.config.ts",
    "test:storybook:watch": "vitest --config vitest.config.ts --watch",
    "test:watch": "vitest --config vite.config.ts",
    "test:coverage": "vitest run --config vite.config.ts --coverage"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "7.3.10",
    "@mui/material": "7.3.10",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-fetch": "^0.222.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-web": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "fabric": "^7.2.0",
    "openseadragon": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.6.0-beta.0",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.0-beta.0",
    "@storybook/addon-themes": "^10.6.0-beta.0",
    "@storybook/addon-vitest": "^10.6.0-beta.0",
    "@storybook/react-vite": "^10.6.0-beta.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.12.0",
    "@types/openseadragon": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.4",
    "chromatic": "^18.9.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "storybook": "^10.6.0-beta.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.3"
  }
}
